{
  "manifest_version": 3,
  "key": "",
  "name": "Sawt: Read Aloud, Locally",
  "version": "0.1.1",
  "description": "Listen to any article read aloud by a natural voice that runs on your own computer. Free, private, no cloud.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Read this page aloud",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:7865/*"
  ],
  "commands": {
    "toggle-reading": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Read this page, or pause / resume"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
